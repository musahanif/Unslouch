model Session {
  session_id             String         @id @default(cuid()) 
  user_id                String         
  device_id              String         

  calibration_id         String?

  start_time             DateTime?
  end_time               DateTime?
  total_good_posture_sec Int?
  total_slouch_sec       Int?
  status                 Session_Status?

  telemetry_revision     Int @default(0)


 
  posture_telemetry_logs   Posture_telemetry_logs[]
  alerts                   Alert[]
  exercise_recommendations Exercise_Recomendation[]
  raw_sensor_batches       RawSensorBatch[]


  user                     User                     @relation(fields: [user_id], references: [user_id])
  device                   Device                  @relation(fields: [device_id], references: [device_id])
  calibration              Calibration? @relation(fields: [calibration_id], references: [calibration_id])

  @@index([user_id, start_time])
  @@index([device_id,status])
}