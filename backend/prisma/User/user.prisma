model User {
  user_id                    String         @id @default(cuid())
  name                       String
  email                      String         @unique
  password                   String
  email_verified_at          DateTime?
  auth_version               Int            @default(0)

  scoliosis_type             SCOLIOSIS_TYPE?
  target_daily_exercise_min  Int?
  posture_alert_threshold_sec Int?
  created_at                 DateTime       @default(now())
  updated_at                 DateTime       @updatedAt

  devices                    Device[]
  calibrations               Calibration[]
  sessions                   Session[]
  alerts                     Alert[]
  exercise_recommendations   Exercise_Recomendation[]
  exercise_logs              Exercise_Log[]

  email_verification_otp     EmailVerificationOtp?
  password_reset_token       PasswordResetToken?

  calibration_commands    CalibrationCommand[]
}